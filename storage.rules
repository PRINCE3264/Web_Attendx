rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Attendance Photos: User can upload to their own folder, Authenticated users (Managers/HR) can read
    match /attendance-photos/{userId}/{photoName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Profile Avatars
    match /profiles/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Generated Attendance PDF / CSV Reports
    match /reports/{reportYearMonth}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Fallback default
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
